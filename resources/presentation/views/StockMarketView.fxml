<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" prefHeight="0" maxHeight="Infinity" VBox.vgrow="ALWAYS"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="presentation.controllers.StockMarketController">

    <Label text="StockMarket" styleClass="section-title"/>

    <VBox spacing="10.0">
        <LineChart fx:id="stockChart" minHeight="300" prefHeight="400.0"
                   VBox.vgrow="NEVER">
            <xAxis>
                <CategoryAxis side="BOTTOM"/>
            </xAxis>
            <yAxis>
                <NumberAxis label="Price" side="LEFT"/>
            </yAxis>
        </LineChart>

        <HBox spacing="10.0">
            <HBox HBox.hgrow="ALWAYS"/>
            <Button mnemonicParsing="false" onAction="#onSevenTicksClicked"
                    text="7 ticks">
            </Button>
            <Button mnemonicParsing="false" onAction="#onThirtyTicksClicked"
                    text="30 ticks">
            </Button>
            <Button mnemonicParsing="false"
                    onAction="#onThreeSixFiveTicksClicked" text="365 ticks">
            </Button>
            <Button mnemonicParsing="false"
                    onAction="#onEighteenTwentyFiveTicksClicked"
                    text="1825 ticks">
            </Button>
            <HBox HBox.hgrow="ALWAYS"/>
        </HBox>
    </VBox>

    <Separator/>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Søg:"/>
        <TextField fx:id="searchField" promptText="Search stock"
                   HBox.hgrow="ALWAYS"/>
        <Button mnemonicParsing="false" text="Search"/>
        <Separator orientation="VERTICAL"/>
        <Button mnemonicParsing="false" text="Buy"/>
        <Button mnemonicParsing="false" text="Sell"/>
    </HBox>

    <TableView fx:id="stockTable" minHeight="140">
        <columns>
            <TableColumn fx:id="selectedColumn" prefWidth="40.0" text=""/>
            <TableColumn fx:id="symbolColumn" prefWidth="100.0" text="Symbol"/>
            <TableColumn fx:id="nameColumn" prefWidth="300.0"
                         text="Company Name"/>
            <TableColumn fx:id="stateColumn" prefWidth="100.0" text="State"/>
            <TableColumn fx:id="priceColumn" prefWidth="100.0"
                         text="Price"/>
        </columns>
    </TableView>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>

</VBox>
